# Copy to .env.local. Nothing in this file is a real secret.
#
# Almost all of these the agent can fill in from CLI output -- see docs/SETUP.md.
# You paste three: ANTHROPIC_API_KEY (Tier 0) and the two GOOGLE_GMAIL_* values
# (Tier 2, not needed until build step 10).
#
# Google *sign-in* credentials deliberately do NOT appear here: they live in the
# Supabase dashboard, because Supabase performs that OAuth exchange.

# --- Supabase (npx supabase projects list / npx supabase projects api-keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string, used by Drizzle and the migration runner.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Settings donate button; falls back to the built-in Stripe Payment Link.
# NEXT_PUBLIC_DONATE_URL=https://buy.stripe.com/...

# --- Token encryption -------------------------------------------------------
# Encrypts OAuth refresh tokens at rest. Generate with:
#   openssl rand -base64 32
# Must NOT be the anon key or the service role key.
TOKEN_ENCRYPTION_KEY=

# --- LLM (build step 9 onwards) ---------------------------------------------
ANTHROPIC_API_KEY=

# --- Books / sell assistant -------------------------------------------------
# Optional free Google Books key (recommended for shelf-photo batches).
# GOOGLE_BOOKS_API_KEY=
# Optional ISBNdb key. Google Books and Open Library lag weeks behind on new
# releases; ISBNdb is the paid catalog that has them on release day.
# ISBNDB_API_KEY=
# BoardGameGeek approved-application token, sent as "Authorization: Bearer".
# Request one at https://boardgamegeek.com/using_the_xml_api — without it a
# deployed server is refused (401/403) and lookups fall back to Wikidata.
# BGG_API_TOKEN=
# Optional UPC database key. Barcode lookups fall back to the keyless trial
# endpoint, which is rate-limited to a few lookups a minute.
# UPCITEMDB_API_KEY=
# Optional buyback aggregator (BookScouter or similar). No scraping.
# BOOKSCOUTER_API_KEY=
# Optional eBay Browse API client credentials (asking prices, not sold).
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=

# --- Gmail read grant (build step 10 onwards) -------------------------------
# A SEPARATE OAuth client from Google sign-in. See docs/SETUP.md, Tier 2.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# --- Cron (build step 13 onwards) -------------------------------------------
# Protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# If unset, TOKEN_ENCRYPTION_KEY is accepted as a local fallback.
CRON_SECRET=

# --- Inngest (build step 12 onwards; not needed for local dev) --------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Local test database ----------------------------------------------------
# Used by npm run db:reset and the RLS / status tests.
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/shopping_manager_test

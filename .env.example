# Copy to .env.local. Nothing in this file is a real secret.
#
# Almost all of these the agent can fill in from CLI output -- see docs/SETUP.md.
# You paste three: ANTHROPIC_API_KEY (Tier 0) and the two GOOGLE_GMAIL_* values
# (Tier 2, not needed until build step 10).
#
# Google *sign-in* credentials deliberately do NOT appear here: they live in the
# Supabase dashboard, because Supabase performs that OAuth exchange.

# --- Supabase (npx supabase projects list / npx supabase projects api-keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection string, used by Drizzle and the migration runner.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Settings donate button; falls back to the built-in Stripe Payment Link.
# NEXT_PUBLIC_DONATE_URL=https://buy.stripe.com/...

# --- Token encryption -------------------------------------------------------
# Encrypts OAuth refresh tokens at rest. Generate with:
#   openssl rand -base64 32
# Must NOT be the anon key or the service role key. Shared by both workspaces,
# which is fine now that they are one deployment.
TOKEN_ENCRYPTION_KEY=

# --- LLM (build step 9 onwards) ---------------------------------------------
ANTHROPIC_API_KEY=

# --- Books / sell assistant -------------------------------------------------
# Optional free Google Books key (recommended for shelf-photo batches).
# GOOGLE_BOOKS_API_KEY=
# Optional ISBNdb key. Google Books and Open Library lag weeks behind on new
# releases; ISBNdb is the paid catalog that has them on release day.
# ISBNDB_API_KEY=
# BoardGameGeek approved-application token, sent as "Authorization: Bearer".
# Request one at https://boardgamegeek.com/using_the_xml_api — without it a
# deployed server is refused (401/403) and lookups fall back to Wikidata.
# BGG_API_TOKEN=
# Optional UPC database key. Barcode lookups fall back to the keyless trial
# endpoint, which is rate-limited to a few lookups a minute.
# UPCITEMDB_API_KEY=
# Optional buyback aggregator (BookScouter or similar). No scraping.
# BOOKSCOUTER_API_KEY=
# Optional eBay Browse API client credentials (asking prices, not sold).
# Must be the PRODUCTION keyset (the client id contains -PRD-); a sandbox
# keyset is refused, because sandbox returns invented listings. The keyset
# also needs the Buy APIs granted -- authenticating is not the same as being
# cleared for Browse. Verify both with: npx tsx scripts/check-ebay.ts <isbn>
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Required for the production keyset to stay enabled: eBay marks an app Non
# Compliant unless it receives marketplace account deletion notifications or
# claims an exemption, and restricts the keyset. Any 32-80 chars of
# [A-Za-z0-9_-]; generate with: openssl rand -hex 24
# Paste the same value into the eBay developer portal alongside the endpoint
# https://<your app url>/api/ebay/account-deletion
# EBAY_VERIFICATION_TOKEN=
# Only if the URL registered with eBay is not NEXT_PUBLIC_APP_URL's. The hash
# is computed over the endpoint, so a mismatch fails validation every time.
# EBAY_DELETION_ENDPOINT_URL=

# --- In-app feedback --------------------------------------------------------
# Code required to submit a bug report or feature request from the header.
# Falls back to the built-in default when unset.
# FEEDBACK_CODE=
#
# The dev buttons fire Claude Code routines. Two queues, so two routines, and
# each needs BOTH an id and its own bearer token -- the token is scoped to the
# routine, not to the account, so the other routine's token answers
# "401 Token is not authorized for this routine".
#
#   notes  /dev/bugs "Run Feature Routine"
#          CLAUDE_NOTES_ROUTINE_ID + CLAUDE_NOTES_ROUTINE_TOKEN
#   plan   /dev/plan "Send to Claude", /dev/ideas "Shape into a plan"
#          CLAUDE_PLAN_ROUTINE_ID + CLAUDE_PLAN_ROUTINE_TOKEN
#
# The ids fall back to CLAUDE_FEATURE_ROUTINE_ID and then to the built-in
# default; the tokens fall back to CLAUDE_API_KEY. Those two are what a single
# shared routine used, so a deployment that sets only them behaves as it did
# before. Set them per queue once there are two routines: the bugs button sends
# no text of its own, so one pointed at the plan routine would not fail -- it
# would quietly build a plan step instead of working the notes queue.
# CLAUDE_NOTES_ROUTINE_ID=
# CLAUDE_NOTES_ROUTINE_TOKEN=
# CLAUDE_PLAN_ROUTINE_ID=
# CLAUDE_PLAN_ROUTINE_TOKEN=
# CLAUDE_API_KEY=
# CLAUDE_FEATURE_ROUTINE_ID=

# --- Gmail read grant (build step 10 onwards) -------------------------------
# A SEPARATE OAuth client from Google sign-in. See docs/SETUP.md, Tier 2.
# These belong to the SHOPPING workspace. The job search workspace has no Gmail
# grant of its own yet -- its OAuth client would need its own redirect URI, and
# the plan is to unify both behind one grant rather than register a second.
# See lib/jobs/email/gmail-availability.ts.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET

# --- Cron (build step 13 onwards) -------------------------------------------
# Protects /api/cron/* (Vercel Cron sends Authorization: Bearer <CRON_SECRET>).
# If unset, TOKEN_ENCRYPTION_KEY is accepted as a local fallback.
# One schedule, /api/cron/daily, runs both workspaces' jobs -- the Hobby plan
# caps crons per project. See docs/SETUP.md.
CRON_SECRET=

# --- Inngest (build step 12 onwards; not needed for local dev) --------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Local test database ----------------------------------------------------
# Used by npm run db:reset and the RLS / status / coexistence tests. One
# database holds both schemas, so both suites point at this single URL.
TEST_DATABASE_URL=postgresql://postgres@localhost:5433/shopping_manager_test
